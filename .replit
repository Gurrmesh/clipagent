run = "uvicorn app.main:app --host 0.0.0.0 --port 8000"
modules = ["python-3.11"]
entrypoint = "app/main.py"

[nix]
channel = "stable-24_05"

[deployment]
run = ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8000
externalPort = 80
