# ClipAgent settings. Copy this file to .env and fill in your own keys.
# Never share .env — it holds your keys.

# ---- Required ----------------------------------------------------------
# Claude picks, styles and checks the clips.  console.anthropic.com -> API keys
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# Whisper transcription. Groq's free tier (fast):
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_API_KEY=gsk_...
WHISPER_MODEL=whisper-large-v3-turbo
# ...or OpenAI instead: OPENAI_API_KEY=sk-...

# ---- Telegram updates (optional) ----------------------------------------
# Make a bot with @BotFather, paste its token here, restart, press Start in the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_SEND_CLIPS=1

# ---- Downloads (optional) ---------------------------------------------------
# cookies.txt from a spare YouTube account, when YouTube blocks downloads ("not a bot")
YTDLP_COOKIES=
# YTDLP_COOKIES_FROM_BROWSER=

# ---- Creator Scan (optional) ---------------------------------------------
# A cheaper model for the first read of a whole catalog (empty = CLAUDE_MODEL)
# CLAUDE_SCREEN_MODEL=
# Seconds between requests to YouTube during a scan (4 is the minimum)
# SCAN_REQUEST_GAP=4

# ---- Machine -------------------------------------------------------------
DATA_DIR=./data
MAX_CLIPS=12
# MAX_SOURCE_MINUTES=240
# AUDIO_CHUNK_SECONDS=600
# How many clips render at once
RENDER_WORKERS=3
# RENDER_PROCESSES=0
# CLIPAGENT_ENGINE=seamless
